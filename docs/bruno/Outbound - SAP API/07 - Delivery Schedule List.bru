meta {
  name: 07 - Delivery Schedule List
  type: http
  seq: 7
}

get {
  url: {{sap_base_url}}/api/sap_del_sched/list?startDate=2026-01-01
  body: none
  auth: bearer
}

params:query {
  startDate: 2026-01-01
}

auth:bearer {
  token: {{sap_token}}
}

headers {
  Host: localhost
  Accept: application/json
}

docs {
  # Delivery Schedule (DELSCHED) List
  
  Service Pengambil: `App\Services\DelSchedService`
  Command Scheduler: `php artisan delsched:run` (08:10 & 14:10 WIB) dan `php artisan sync:delivery-data`.
  
  Tabel Tujuan: `sap_delsched`
  Kolom Utama: `item_code`, `delivery_date`, `delivery_qty`, `so_number`.
}
